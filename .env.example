# FastAPI Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# Database Configuration (Supabase PostgreSQL async connection)
# Example: postgresql+asyncpg://postgres:password@db.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Supabase Credentials
SUPABASE_URL=https://placeholder-project.supabase.co
SUPABASE_KEY=placeholder-anon-key
JWT_SECRET=placeholder-jwt-secret

# AWS Credentials and Services
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock-access-key-id
AWS_SECRET_ACCESS_KEY=mock-secret-access-key
TEXTRACT_REGION=us-east-1

# Tesseract OCR Configuration
TESSERACT_CMD=C:\Users\DE_004\AppData\Local\Programs\Tesseract-OCR\tesseract.exe
